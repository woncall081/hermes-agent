[Unit]
Description=Decrypt Hermes credentials into non-swappable runtime memory
Requires=run-hermes\x2druntime.mount
After=run-hermes\x2druntime.mount local-fs.target
Before=docker.service
RequiresMountsFor=/home/hermes/.hermes

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
LoadCredentialEncrypted=op-service-account-token:/etc/credstore.encrypted/hermes-op-service-account-token.cred
LoadCredentialEncrypted=op-connect-credentials:/etc/credstore.encrypted/hermes-connect-current/op-connect-credentials.cred
LoadCredentialEncrypted=op-connect-token:/etc/credstore.encrypted/hermes-connect-current/op-connect-token.cred
LoadCredentialEncrypted=default-env:/etc/credstore.encrypted/hermes-default-env.cred
LoadCredentialEncrypted=agency-env:/etc/credstore.encrypted/hermes-agency-env.cred
LoadCredentialEncrypted=default-auth:/etc/credstore.encrypted/hermes-default-auth.cred
LoadCredentialEncrypted=be-auth:/etc/credstore.encrypted/hermes-be-auth.cred
LoadCredentialEncrypted=fe-auth:/etc/credstore.encrypted/hermes-fe-auth.cred
LoadCredentialEncrypted=codex-auth:/etc/credstore.encrypted/hermes-codex-auth.cred
LoadCredentialEncrypted=codex-config:/etc/credstore.encrypted/hermes-codex-config.cred
LoadCredentialEncrypted=agency-google-client-secret:/etc/credstore.encrypted/hermes-agency-google-client-secret.cred
LoadCredentialEncrypted=agency-google-token:/etc/credstore.encrypted/hermes-agency-google-token.cred
ExecStart=/usr/local/libexec/hermes-credential-runtime-start
ExecStop=/usr/local/libexec/hermes-credential-sync
TimeoutStartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
