#!/bin/sh
set -eu

runtime=/run/hermes-runtime
manifest=/usr/local/lib/hermes-credential-runtime/credential-manifest.sh

[ -n "${CREDENTIALS_DIRECTORY:-}" ] || {
    echo "systemd credential directory is unavailable" >&2
    exit 1
}
. "$manifest"

# Rebuild the volatile view from the encrypted-at-rest source of truth.
find "$runtime" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
install -d -m 0711 -o root -g root "$runtime"

hermes_credentials | while IFS='|' read -r name _persistent relative; do
    [ -n "$relative" ] || continue
    credential="$CREDENTIALS_DIRECTORY/$name"
    [ -f "$credential" ] || {
        echo "missing systemd credential: $name" >&2
        exit 1
    }
    destination="$runtime/$relative"
    install -d -m 0700 -o hermes -g hermes "$(dirname "$destination")"
    if [ "$name" = op-connect-credentials ]; then
        install -m 0400 -o 999 -g 999 "$credential" "$destination"
    elif [ "$name" = op-service-account-token ] || [ "$name" = op-connect-token ]; then
        install -m 0400 -o hermes -g hermes "$credential" "$destination"
    else
        install -m 0600 -o hermes -g hermes "$credential" "$destination"
    fi
done

for credential in "$CREDENTIALS_DIRECTORY"/tree-mcp-tokens--*; do
    [ -f "$credential" ] || continue
    encoded=${credential##*--}
    relative=$(python3 - "$encoded" <<'PY'
import sys
try:
    value = bytes.fromhex(sys.argv[1]).decode("utf-8")
except Exception:
    raise SystemExit(1)
if not value or value.startswith("/") or ".." in value.split("/"):
    raise SystemExit(1)
print(value)
PY
)
    destination="$runtime/mcp-tokens/$relative"
    install -d -m 0700 -o hermes -g hermes "$(dirname "$destination")"
    install -m 0600 -o hermes -g hermes "$credential" "$destination"
done

[ -d "$runtime/mcp-tokens" ] || {
    echo "MCP credential tree did not materialize" >&2
    exit 1
}
