#!/bin/bash
set -euo pipefail
umask 077

runtime=/run/hermes-runtime
store=/etc/credstore.encrypted
manifest=/usr/local/lib/hermes-credential-runtime/credential-manifest.sh
dropin=/etc/systemd/system/hermes-credential-runtime.service.d/tree-credentials.conf
lock=/run/lock/hermes-credential-sync.lock

exec 9>"$lock"
flock -n 9 || exit 0
. "$manifest"
install -d -m 0700 -o root -g root "$store"

validate_runtime_file() {
    local path=$1 mode owner
    [ -f "$path" ] && [ ! -L "$path" ] || {
        echo "refusing invalid runtime credential: $path" >&2
        exit 1
    }
    owner=$(stat -c '%u:%g' "$path")
    mode=$(stat -c '%a' "$path")
    [ "$owner" = "1000:1000" ] || {
        echo "refusing runtime credential with unsafe ownership: $path" >&2
        exit 1
    }
    case "$mode" in 400|600) ;; *)
        echo "refusing runtime credential with unsafe mode: $path" >&2
        exit 1
        ;;
    esac
}

encrypt_file() {
    local name=$1 source=$2 output temporary check
    output="$store/hermes-$name.cred"
    temporary="$store/.hermes-$name.cred.tmp.$$"
    check="/run/hermes-credential-sync-verify-${name//\//_}.$$"
    trap 'rm -f -- "$temporary" "$check"' RETURN
    systemd-creds encrypt --quiet --with-key=host --name="$name" "$source" "$temporary"
    chmod 0600 "$temporary"
    chown root:root "$temporary"
    systemd-creds decrypt --quiet --name="$name" "$temporary" "$check"
    cmp -s "$source" "$check" || {
        echo "credential verification failed: $name" >&2
        exit 1
    }
    mv -f "$temporary" "$output"
    rm -f "$check"
    trap - RETURN
}

while IFS='|' read -r name _persistent relative; do
    [ -n "$relative" ] || continue
    # Connect's server credential and bearer are an immutable generation pair.
    # Rotation is committed atomically by provision_connect_credentials.py;
    # never overwrite either member from the materialized runtime view.
    case "$name" in
        op-connect-credentials|op-connect-token) continue ;;
    esac
    source="$runtime/$relative"
    validate_runtime_file "$source"
    encrypt_file "$name" "$source"
done < <(hermes_credentials)

declare -A wanted=()
tree_root="$runtime/mcp-tokens"
[ -d "$tree_root" ] && [ ! -L "$tree_root" ] || {
    echo "MCP runtime credential tree is invalid" >&2
    exit 1
}
while IFS= read -r -d '' source; do
    validate_runtime_file "$source"
    relative=${source#"$tree_root"/}
    encoded=$(python3 - "$relative" <<'PY'
import sys
value = sys.argv[1]
if not value or value.startswith("/") or ".." in value.split("/"):
    raise SystemExit(1)
print(value.encode("utf-8").hex())
PY
)
    name="tree-mcp-tokens--$encoded"
    wanted["$store/hermes-$name.cred"]=1
    encrypt_file "$name" "$source"
done < <(find "$tree_root" -type f -print0)

for stale in "$store"/hermes-tree-mcp-tokens--*.cred; do
    [ -e "$stale" ] || continue
    [ -n "${wanted[$stale]:-}" ] || rm -f -- "$stale"
done

install -d -m 0755 -o root -g root "$(dirname "$dropin")"
temporary_dropin="$(dirname "$dropin")/.tree-credentials.conf.tmp.$$"
{
    echo '[Service]'
    for blob in "$store"/hermes-tree-mcp-tokens--*.cred; do
        [ -e "$blob" ] || continue
        base=$(basename "$blob")
        name=${base#hermes-}
        name=${name%.cred}
        printf 'LoadCredentialEncrypted=%s:%s\n' "$name" "$blob"
    done
} > "$temporary_dropin"
chmod 0644 "$temporary_dropin"
mv -f "$temporary_dropin" "$dropin"
systemctl daemon-reload
