[Unit]
Description=Watch mutable Hermes runtime credentials for encrypted persistence
After=hermes-credential-runtime.service
Requires=hermes-credential-runtime.service

[Path]
PathChanged=/run/hermes-runtime/.env
PathChanged=/run/hermes-runtime/profiles/agency/.env
PathChanged=/run/hermes-runtime/auth.json
PathChanged=/run/hermes-runtime/profiles/be/auth.json
PathChanged=/run/hermes-runtime/profiles/fe/auth.json
PathChanged=/run/hermes-runtime/codex
PathChanged=/run/hermes-runtime/mcp-tokens
PathChanged=/run/hermes-runtime/profiles/agency/google_client_secret.json
PathChanged=/run/hermes-runtime/profiles/agency/google_token.json
PathChanged=/run/hermes-runtime/profiles/agency/google_oauth_pending.json
Unit=hermes-credential-sync.service

[Install]
WantedBy=multi-user.target
